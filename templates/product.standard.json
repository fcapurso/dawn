{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "subtitle": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "judge_me_reviews_preview_badge": {
          "type": "shopify://apps/judge-me-reviews/blocks/preview_badge/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "discounts": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% if product.metafields.my_fields.discounts != blank %}<span class=\"price-item price-item--regular\">{{ product.metafields.my_fields.discounts }}</span>{% endif %}"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "dropdown",
            "swatch_shape": "circle"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "low_stock_threshold": 5,
            "high_stock_threshold": 5,
            "show_inventory_quantity": true,
            "availability_type": "items"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "product_info": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<h4>Over {{product.title}}</h4>"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "product_logos": {
          "type": "custom-product-logos",
          "settings": {
            "selected_image_1": "shopify://shop_images/vegan_logo.png",
            "product_tag_1": "vegan",
            "selected_image_2": "shopify://shop_images/vegetarian_logo.png",
            "product_tag_2": "vegetarian",
            "selected_image_3": "shopify://shop_images/palm_oil_free_logo.png",
            "product_tag_3": "palmolievrij",
            "selected_image_4": "shopify://shop_images/cruelty_free_logo.png",
            "product_tag_4": "dierproefvrij",
            "selected_image_5": "shopify://shop_images/handmade_with_love_logo.png",
            "product_tag_5": "handgemaakt"
          }
        },
        "usage": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Gebruik",
            "icon": "heart",
            "content": "<p>{{ product.metafields.my_fields.advice_for_use | metafield_tag }}</p>",
            "page": "",
            "shared_text": "category_usage",
            "hide_when_empty": true
          }
        },
        "ingredients": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Wat zit er allemaal in?",
            "icon": "leaf",
            "content": "<p>{{ product.metafields.my_fields.ingredients | metafield_tag }}</p>",
            "page": "",
            "shared_text": "none",
            "hide_when_empty": true
          }
        },
        "good_to_know": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Goed om te weten",
            "icon": "star",
            "content": "<p>{{ product.metafields.custom.good_to_know | metafield_tag }}</p>",
            "page": "",
            "shared_text": "category_good_to_know",
            "hide_when_empty": true
          }
        },
        "brand": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Waarom {{ product.vendor }}",
            "icon": "star",
            "content": "",
            "page": "",
            "shared_text": "brand_about",
            "hide_when_empty": true
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Verzendkosten",
            "icon": "truck",
            "content": "{{ metaobjects.info_text[\"shipping-info\"].body | metafield_tag }}",
            "page": "",
            "shared_text": "none",
            "hide_when_empty": true
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Delen"
          }
        },
        "judge_me_reviews_review_widget": {
          "type": "shopify://apps/judge-me-reviews/blocks/review_widget/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8",
          "settings": {
            "empty_state": "empty_widget",
            "review_data": "sample_data",
            "max_width": 1200,
            "show_shop_reviews": false
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "subtitle",
        "judge_me_reviews_preview_badge",
        "price",
        "discounts",
        "variant_picker",
        "inventory",
        "quantity_selector",
        "buy_buttons",
        "product_info",
        "description",
        "product_logos",
        "usage",
        "ingredients",
        "good_to_know",
        "brand",
        "shipping",
        "share",
        "judge_me_reviews_review_widget"
      ],
      "custom_css": [],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "",
        "media_size": "small",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "media_position": "left",
        "image_zoom": "hover",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Ook leuk voor jou?",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "background-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
